<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Approved_Application_Requires_Reviewer</fullName>
    <active>true</active>
    <description>Approved applications must have a reviewer assigned.</description>
    <errorConditionFormula>AND(
ISPICKVAL(Status__c,&quot;Approved&quot;),
ISBLANK(Reviewer__c)
)</errorConditionFormula>
    <errorDisplayField>Reviewer__c</errorDisplayField>
    <errorMessage>Please assign a Reviewer before approving the application.</errorMessage>
</ValidationRule>
