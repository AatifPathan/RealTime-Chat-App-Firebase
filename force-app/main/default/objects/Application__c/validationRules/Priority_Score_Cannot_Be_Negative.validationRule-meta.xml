<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Priority_Score_Cannot_Be_Negative</fullName>
    <active>true</active>
    <description>Prevents negative priority scores.</description>
    <errorConditionFormula>Priority_Score__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Priority_Score__c</errorDisplayField>
    <errorMessage>Priority Score cannot be less than 0.</errorMessage>
</ValidationRule>
