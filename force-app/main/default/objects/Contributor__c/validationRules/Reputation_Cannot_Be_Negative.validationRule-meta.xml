<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reputation_Cannot_Be_Negative</fullName>
    <active>true</active>
    <description>Prevents negative reputation scores.</description>
    <errorConditionFormula>Reputation_Score__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Reputation_Score__c</errorDisplayField>
    <errorMessage>Reputation Score cannot be less than 0.</errorMessage>
</ValidationRule>
