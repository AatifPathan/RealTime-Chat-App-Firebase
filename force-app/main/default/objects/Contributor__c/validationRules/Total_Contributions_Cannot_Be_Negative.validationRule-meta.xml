<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_Contributions_Cannot_Be_Negative</fullName>
    <active>true</active>
    <description>Prevents negative contribution counts.</description>
    <errorConditionFormula>Total_Contributions__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Total_Contributions__c</errorDisplayField>
    <errorMessage>Total Contributions cannot be less than 0.</errorMessage>
</ValidationRule>
