<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Active_Repository_Must_Have_Active_Statu</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
Active__c,
NOT(ISPICKVAL(Status__c,&quot;Active&quot;))
)</errorConditionFormula>
    <errorDisplayField>Active__c</errorDisplayField>
    <errorMessage>If the repository is marked Active, the Status must be Active.</errorMessage>
</ValidationRule>
