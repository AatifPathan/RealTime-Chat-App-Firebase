<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Forks_Cannot_Be_Negative</fullName>
    <active>true</active>
    <description>Prevents users from entering a negative number of forks.</description>
    <errorConditionFormula>Forks__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Forks__c</errorDisplayField>
    <errorMessage>Forks cannot be less than 0.</errorMessage>
</ValidationRule>
