<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Open_Issues_Cannot_Be_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>Open_Issues__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Open_Issues__c</errorDisplayField>
    <errorMessage>Open Issues cannot be less than 0.</errorMessage>
</ValidationRule>
